SHTTP_PORT=8080
SSE_PORT=8081

GITHUB_API_TIMEOUT=30

# FastMCP settings
FASTMCP_LOG_LEVEL=DEBUG
FASTMCP_DEBUG=true

# Sampling (LLM integration) — optional
# To enable: fill in your Anthropic API key and run `uv add anthropic`
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001